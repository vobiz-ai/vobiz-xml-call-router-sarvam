# ─── Public URL ───────────────────────────────────────────────────────────
# Where the voice platform can reach this service. Must be HTTPS.
#   cloudflared tunnel --url http://localhost:8090
PUBLIC_URL=https://your-tunnel.example.com
PORT=8090

# ─── Platform credentials ─────────────────────────────────────────────────
# Only needed for /escalate (the live transfer API) and `test.py call`.
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
FROM_NUMBER=

# Caller ID for outbound legs to human agents. MUST be a number your account
# owns — if unset, the platform derives it from the inbound leg, which on a
# forwarded call is not an owned number and the dial fails silently.
CALLER_ID=

# ─── Routing policy ───────────────────────────────────────────────────────
# ai_first    — try AI, overflow to human
# human_first — try human, overflow to AI
ROUTE_POLICY=ai_first

AI_CAPACITY=50
HUMAN_CAPACITY=30
QUEUE_CAPACITY=5
QUEUE_MAX_CYCLES=3
HOLD_SECONDS=15

# ─── Caller identity ──────────────────────────────────────────────────────
# sim_forward — calls arrive via a forwarding line, so `From` is that line and
#               the real caller is only knowable via ForwardedFrom, which the
#               platform populates from the SIP Diversion header
# direct_did  — callers dial your number directly, so `From` IS the caller
INBOUND_MODE=direct_did
# The forwarding line's own number, when known. Lets the router say "this is
# the forwarder, not a caller" rather than merely suspecting it.
SIM_NUMBER=
REPEAT_CALLER_ROUTING=true
REPEAT_WINDOW_DAYS=30

# ─── The AI backend ───────────────────────────────────────────────────────
# stub   — <Speak> describing the decision. No backend needed. Start here.
# proxy  — POST the call to the backend's answer URL, return its XML
# stream — <Stream> to a websocket this service builds
AI_MODE=stub

# proxy mode
AI_ANSWER_URL=
# Rewrite `To` to AI_TARGET_* so the router picks the agent. Off by default:
# if nothing is listening on that identifier the backend may accept the
# connection and drop it silently.
PROXY_REWRITE_TO=false

# stream mode
AI_STREAM_URL=
AI_CONTENT_TYPE=audio/x-mulaw;rate=8000

# Optional: which agent should answer, per pool. Empty means let the backend
# decide from the dialled number.
AI_TARGET_NEW=
AI_TARGET_REPEAT=

# Map the router's canonical stream parameters onto your backend's names, e.g.
#   STREAM_PARAM_MAP=caller:user_phone_number,target:agent_phone_number,call_id:call_sid
# Canonical fields: caller, called, target, call_id, direction
STREAM_PARAM_MAP=

# Prefix for the context fields the router adds alongside the backend's own.
CONTEXT_PREFIX=router_

AI_TIMEOUT_S=2.0
AI_FALLBACK_TEXT=We could not connect you to an agent. Please try again shortly.

# Give the backend the resolved caller in the `From` field it already reads.
# The raw value the platform sent is preserved as OriginalFrom.
FORWARD_RESOLVED_FROM=true

# ─── Human agents ─────────────────────────────────────────────────────────
# Comma-separated. A PSTN number is dialled with <Number>; anything starting
# with "sip:" is dialled with <User>. Also registrable at runtime via /agents.
#   AGENT_NUMBERS=+14155550100,sip:agent@example.com
AGENT_NUMBERS=
DIAL_TIMEOUT=30

# ─── Optional ─────────────────────────────────────────────────────────────
HOLD_MUSIC_URL=
SMS_WEBHOOK_URL=
MAX_CALL_SECONDS=3600
SPEAK_VOICE=WOMAN
SPEAK_LANGUAGE=en-US

# Test only: allows ?force=human|ai on the answer URL to pin a branch.
ALLOW_FORCE_ROUTE=false
