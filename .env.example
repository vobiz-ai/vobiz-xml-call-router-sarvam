# ─── Public URL ───────────────────────────────────────────────────────────
# Where Vobiz can reach this service. Must be HTTPS.
#   cloudflared tunnel --url http://localhost:8090
PUBLIC_URL=https://your-tunnel.trycloudflare.com
PORT=8090

# ─── Vobiz credentials ────────────────────────────────────────────────────
# Only needed for /escalate (the live transfer API) and call.py.
# Use an account with balance, and a DID it owns.
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
FROM_NUMBER=

# Caller ID for outbound legs to human agents. MUST be a number owned by the
# account — if unset, Vobiz derives it from the inbound leg, which on a
# forwarded call is not an owned number and the dial fails silently with
# DialStatus=failed / ORIGINATOR_CANCEL.
CALLER_ID=

# ─── Routing policy ───────────────────────────────────────────────────────
# ai_first    — try AI, overflow to human   (the email thread's requirement)
# human_first — try human, overflow to AI   (the capacity flowchart)
ROUTE_POLICY=ai_first

AI_CAPACITY=50
HUMAN_CAPACITY=30
QUEUE_CAPACITY=5
QUEUE_MAX_CYCLES=3
HOLD_SECONDS=15

# For the thread's "70% of channels reserved for AI": with 100 total channels
# that is AI_CAPACITY=70, HUMAN_CAPACITY=30.

# ─── Caller identity ──────────────────────────────────────────────────────
# sim_forward — calls arrive via a forwarding SIM, so `From` is the SIM and
#               the citizen is only knowable via ForwardedFrom (SIP Diversion)
# direct_did  — callers dial the Vobiz DID directly, so `From` IS the caller
INBOUND_MODE=sim_forward
SIM_NUMBER=
REPEAT_CALLER_ROUTING=true
REPEAT_WINDOW_DAYS=30

# ─── The AI side ──────────────────────────────────────────────────────────
# stub   — <Speak> what would have happened. Proves routing with no Sarvam
#          dependency at all. Start here.
# stream — <Stream> to Sarvam's websocket
# proxy  — fetch XML from Sarvam's own answer URL and pass it through
AI_MODE=stub
SARVAM_STREAM_WS=
SARVAM_STREAM_WS_REPEAT=
SARVAM_ANSWER_URL=
SARVAM_TIMEOUT_S=2.0

# AI_MODE=sarvam_stream — IPAC builds Sarvam's websocket URL itself, so it can
# set user_phone_number to the real caller. Each agent is a number registered
# with Sarvam; that is how IPAC picks which agent answers.
SARVAM_WSS=wss://apps.sarvam.ai/api/app-runtime/v1/channels/vobiz
SARVAM_AGENT_NEW=
SARVAM_AGENT_REPEAT=
SARVAM_CONTENT_TYPE=audio/x-l16;rate=8000

# Give Sarvam the resolved caller in the `From` field it already reads, so it
# sees the citizen rather than the forwarding SIM. The raw value Vobiz sent is
# preserved as OriginalFrom. Only applied when the identity is trusted.
FORWARD_RESOLVED_FROM=true

# ─── Human agents ─────────────────────────────────────────────────────────
# Comma-separated E.164 numbers. Also registrable at runtime over POST /agents.
AGENT_NUMBERS=
DIAL_TIMEOUT=30

# ─── Optional ─────────────────────────────────────────────────────────────
HOLD_MUSIC_URL=
SMS_WEBHOOK_URL=
MAX_CALL_SECONDS=3600
SPEAK_VOICE=WOMAN
SPEAK_LANGUAGE=en-IN
